<?xml version="1.0" encoding="utf-8"?>
<!--
  Twin of the SF Symbol `square.and.pencil` used on the iOS home header, which
  material-icons-extended has no exact match for (Icons.Outlined.Edit is a bare
  pencil). Stroked rather than filled so the weight reads like SF's .medium.
  The square's top-right is left open where the pencil crosses it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M13.5,3.75 H6 A2.25,2.25 0 0 0 3.75,6 V18 A2.25,2.25 0 0 0 6,20.25 H18 A2.25,2.25 0 0 0 20.25,18 V10.5"
        android:strokeColor="#000000"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M18.6,3.2 L20.8,5.4 L12.4,13.8 L9.4,14.6 L10.2,11.6 Z"
        android:strokeColor="#000000"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
